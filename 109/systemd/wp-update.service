[Unit]
Description=WordPress Update All Sites (109-RU)
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash /root/wp_update_all.sh
StandardOutput=append:/var/log/wp_update.log
StandardError=append:/var/log/wp_update.log

[Install]
WantedBy=multi-user.target
