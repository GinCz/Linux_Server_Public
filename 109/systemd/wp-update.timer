# =============================================================================
#  wp-update.timer  —  109-RU-FastVDS
# =============================================================================
#  Runs nightly at 03:00 (Wednesday + Saturday)
#  Offset +1h from 222 to avoid simultaneous load on shared resources
# =============================================================================
[Unit]
Description=Run WordPress Update All Sites twice a week
Requires=wp-update.service

[Timer]
OnCalendar=Wed,Sat *-*-* 03:00:00
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
