# SSH Config для VS Code Remote-SSH (Пример / Template)
# Путь файла на Windows: C:\Users\USER\.ssh\config

Host Server-Main
    HostName 192.168.1.100
    User root
    Port 22
    IdentityFile C:/Users/USER/.ssh/id_rsa

Host Server-Backup
    HostName 192.168.1.101
    User root
    Port 22
    IdentityFile C:/Users/USER/.ssh/id_rsa