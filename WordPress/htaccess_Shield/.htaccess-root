# ------------------------------------------------------------------------------
# 1. SECURITY HEADERS (Apache 2.4+ / mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # 1.1 Protect against Cross-Site Scripting (XSS)
    Header set X-XSS-Protection "1; mode=block"

    # 1.2 Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"

    # 1.3 Referrer policy for privacy and tracking control
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # 1.4 Clickjacking protection (allow framing only by same origin)
    Header always set X-Frame-Options "SAMEORIGIN"

    # 1.5 Strict-Transport-Security (HSTS) - Enforce HTTPS for 1 year
    # (Active only when HTTPS is detected to prevent lockouts)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ------------------------------------------------------------------------------
# 2. FILE & SCRIPT PROTECTION (Anti-Hacking Shield)
# ------------------------------------------------------------------------------

# 2.1 Block critical WordPress configuration file
<Files wp-config.php>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 2.2 Disable XML-RPC (Blocks 95% of Brute Force & Pingback DDoS Attacks)
<Files xmlrpc.php>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 2.3 Block direct access to sensitive configuration, backup, and log files
<FilesMatch "(^#.*#|\.(bak|backup|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|git.*|yml|yaml|md))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2.4 Disable Directory Browsing (Prevents directory structure indexing)
Options -Indexes

# ------------------------------------------------------------------------------
# 3. WORDPRESS CORE REWRITES & REWRITER ENGINE RULES (mod_rewrite)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 3.1 Pass HTTP Authorization Header for REST API / OAuth compatibility
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3.2 Block Author User Enumeration Scanners (e.g., /?author=1)
    RewriteCond %{QUERY_STRING} ^author=([0-9]+) [NC]
    RewriteRule ^(.*)$ /? [L,R=301]

    # 3.3 Block Malicious Query Strings and Injections
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|localhost|loopback|127\.0\.0\.1) [NC,OR]
    RewriteCond %{QUERY_STRING} (GLOBALS|REQUEST)(=|\[|%) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (\<|%3C).*iframe.*(\>|%3E) [NC]
    RewriteRule .* - [F,L]

    # 3.4 Standard WordPress Front Controller Routing
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. PERFORMANCE: BROWSER CACHING (mod_expires & mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML / Dynamic Data
    ExpiresByType text/html "access plus 1 day"

    # Media & Images (1 Year Cache)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Web Fonts (1 Year Cache)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS & JavaScript (6 Months Cache)
    ExpiresByType text/css "access plus 6 months"
    ExpiresByType application/javascript "access plus 6 months"
    ExpiresByType text/javascript "access plus 6 months"
</IfModule>

# ------------------------------------------------------------------------------
# 5. MIME TYPES CORRECTION
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>